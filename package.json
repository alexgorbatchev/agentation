{
  "name": "agentation-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @alexgorbatchev/agentation watch & pnpm --filter feedback-tool-example dev",
    "storybook": "pnpm --filter @alexgorbatchev/agentation storybook",
    "typecheck": "pnpm -r --if-present run typecheck",
    "pretest": "pnpm typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "build": "pnpm -r run build",
    "build:agentation": "pnpm --filter @alexgorbatchev/agentation build",
    "build:storybook": "pnpm --filter @alexgorbatchev/agentation build-storybook",
    "pack": "pnpm build && pnpm --filter @alexgorbatchev/agentation pack",
    "publish:agentation": "pnpm --filter @alexgorbatchev/agentation publish --access public",
    "publish:all": "pnpm publish:agentation"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
