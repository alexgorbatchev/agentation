{
  "name": "agentation-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter agentation watch & pnpm --filter feedback-tool-example dev",
    "dev:mcp": "pnpm --filter agentation-mcp dev",
    "storybook": "pnpm --filter agentation storybook",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "build": "pnpm -r run build",
    "build:agentation": "pnpm --filter agentation build",
    "build:mcp": "pnpm --filter agentation-mcp build",
    "build:storybook": "pnpm --filter agentation build-storybook",
    "pack": "pnpm build && pnpm --filter agentation pack && pnpm --filter agentation-mcp pack",
    "publish:agentation": "pnpm --filter agentation publish --access public",
    "publish:mcp": "pnpm --filter agentation-mcp publish --access public",
    "publish:all": "pnpm publish:agentation && pnpm publish:mcp"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
